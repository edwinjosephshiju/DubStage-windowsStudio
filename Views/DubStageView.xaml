<UserControl
    x:Class="DubStage.Views.DubStageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:DubStage.Views.Components"
    xmlns:models="using:DubStage.Models">

    <Grid Margin="16" RowSpacing="14">
        <Grid.RowDefinitions>
            <!-- 1: Dialogue Teleprompter & Live Recording Booth -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Synchronized Dual Waveform Visualizer -->
            <RowDefinition Height="*"/>
            <!-- 3: Takes Carousel & Audition Deck -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 1: TELEPROMPTER & BOOTH -->
        <Border Grid.Row="0" Background="#16181D" BorderBrush="#2D313A" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <!-- Teleprompter Cue (Flexible) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Live VU Meter -->
                    <ColumnDefinition Width="160"/>
                    <!-- Big Record & Transport Buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Dialogue Line Teleprompter -->
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#4F80FF" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="{x:Bind ViewModel.ActiveClip.ClipIndex, Mode=OneWay, FallbackValue=1}" FontSize="12" FontWeight="Bold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.ActiveClip.SpeakerName, Mode=OneWay, FallbackValue='Speaker 1'}" FontSize="14" FontWeight="Bold" Foreground="#00E5A3"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveClip.DurationMs, Mode=OneWay, Converter={StaticResource MsToTimecodeConverter}, FallbackValue='00:00.0'}" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>

                    <!-- Large readable script text for voice actor -->
                    <TextBlock Text="{x:Bind ViewModel.ActiveClip.ScriptText, Mode=OneWay, FallbackValue='No clip selected. Select a cue or detect dialogue in DubForge.'}" FontSize="20" FontWeight="SemiBold" Foreground="#F0F2F5" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Live VU Meter -->
                <components:VuMeterControl Grid.Column="1" LeftLevelDb="{x:Bind ViewModel.VuMeterLeftDb, Mode=OneWay}" RightLevelDb="{x:Bind ViewModel.VuMeterRightDb, Mode=OneWay}" VerticalAlignment="Center"/>

                <!-- Booth Transport Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Prev Clip -->
                    <Button Command="{x:Bind ViewModel.PreviousClipCommand}" ToolTipService.ToolTip="Previous Clip (Up Arrow)" Background="#21242C" Width="42" Height="42" CornerRadius="21">
                        <FontIcon Glyph="&#xE70E;" FontSize="14" Foreground="#F0F2F5"/>
                    </Button>

                    <!-- Play / Pause -->
                    <Button Command="{x:Bind ViewModel.TogglePlayPauseCommand}" ToolTipService.ToolTip="Play / Pause (Space)" Background="#21242C" Width="48" Height="48" CornerRadius="24">
                        <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseIconConverter}}" FontSize="18" Foreground="#F0F2F5"/>
                    </Button>

                    <!-- GIANT RECORD / STOP BUTTON -->
                    <Button Command="{x:Bind ViewModel.ToggleRecordCommand}" ToolTipService.ToolTip="Record / Stop Take (R)" Background="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource RecordingButtonColorConverter}}" Width="56" Height="56" CornerRadius="28">
                        <FontIcon Glyph="{x:Bind ViewModel.IsRecording, Mode=OneWay, Converter={StaticResource RecordingIconConverter}}" FontSize="20" Foreground="White"/>
                    </Button>

                    <!-- Next Clip -->
                    <Button Command="{x:Bind ViewModel.NextClipCommand}" ToolTipService.ToolTip="Next Clip (Down Arrow)" Background="#21242C" Width="42" Height="42" CornerRadius="21">
                        <FontIcon Glyph="&#xE70D;" FontSize="14" Foreground="#F0F2F5"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: DUAL WAVEFORM SYNC DECK -->
        <components:DualWaveformControl x:Name="WaveformControl" Grid.Row="1" VocalPeaks="{x:Bind ViewModel.VocalPeaks, Mode=OneWay}" TakePeaks="{x:Bind ViewModel.ActiveTakePeaks, Mode=OneWay}" PlayheadMs="{x:Bind ViewModel.PlayheadMs, Mode=OneWay}" DurationMs="{x:Bind ViewModel.ActiveProject.VideoDurationMs, Mode=OneWay, FallbackValue=1000}" SeekRequested="OnWaveformSeekRequested"/>

        <!-- ROW 3: TAKES CAROUSEL & AUDITION DECK -->
        <Border Grid.Row="2" Background="#16181D" BorderBrush="#2D313A" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <!-- Takes list -->
                    <ColumnDefinition Width="*"/>
                    <!-- Take Fine-tuning sliders (Gain & Time offset) -->
                    <ColumnDefinition Width="320"/>
                    <!-- Master Export Button -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Takes List for Active Clip -->
                <StackPanel Grid.Column="0" Spacing="8">
                    <Grid>
                        <TextBlock Text="RECORDED TAKES" FontSize="11" FontWeight="Bold" Foreground="#9AA0A6"/>
                        <TextBlock Text="{x:Bind ViewModel.Takes.Count, Mode=OneWay, Converter={StaticResource ClipCountConverter}}" FontSize="11" Foreground="#00E5A3" HorizontalAlignment="Right"/>
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Takes, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.ActiveTake, Mode=TwoWay}" MaxHeight="110" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:TakeEntity">
                                <Border Background="#21242C" CornerRadius="6" Padding="8,4" Margin="0,2">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#00E5A3" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="{x:Bind TakeNumber}" FontSize="11" FontWeight="Bold" Foreground="Black"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Vocal Take" FontSize="12" Foreground="#F0F2F5" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind DurationMs, Converter={StaticResource MsToTimecodeConverter}}" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center" FontFamily="Consolas"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind GainDb}" FontSize="11" Foreground="#4F80FF" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Take Micro-Tuning Sliders -->
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <!-- Gain Slider -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Take Gain:" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-12" Maximum="12" StepFrequency="0.5" Value="{x:Bind ViewModel.ActiveTake.GainDb, Mode=TwoWay, FallbackValue=0}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ActiveTake.GainDb, Mode=OneWay, FallbackValue=0}" FontSize="11" Foreground="#00E5A3" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </Grid>

                    <!-- Time Offset Nudge Slider -->
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nudge (Sync):" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" Minimum="-500" Maximum="500" StepFrequency="10" Value="{x:Bind ViewModel.ActiveTake.TimeOffsetMs, Mode=TwoWay, FallbackValue=0}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ActiveTake.TimeOffsetMs, Mode=OneWay, FallbackValue=0}" FontSize="11" Foreground="#4F80FF" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </Grid>

                    <!-- Audition Mode Selection -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Mute Original (Ctrl+M)" Command="{x:Bind ViewModel.ToggleMuteOriginalCommand}" Background="#21242C" Foreground="#F0F2F5" FontSize="11" Padding="8,4" CornerRadius="4"/>
                        <Button Content="Delete Take (Del)" Command="{x:Bind ViewModel.DeleteActiveTakeCommand}" Background="#21242C" Foreground="#FF5376" FontSize="11" Padding="8,4" CornerRadius="4"/>
                    </StackPanel>
                </StackPanel>

                <!-- Export Master Panel -->
                <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                    <Button Content="EXPORT MASTER (Ctrl+E)" Click="OnExportMasterClick" Background="#4F80FF" Foreground="White" FontWeight="Bold" FontSize="13" Padding="20,14" CornerRadius="8"/>
                    <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsExporting, Mode=OneWay}" Value="{x:Bind ViewModel.ExportProgress.Percent, Mode=OneWay, FallbackValue=0}" Foreground="#00E5A3" Background="#21242C" Height="4" CornerRadius="2"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
