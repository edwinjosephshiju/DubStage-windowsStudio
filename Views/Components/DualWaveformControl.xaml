<UserControl
    x:Class="DubStage.Views.Components.DualWaveformControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#16181D" CornerRadius="8" BorderBrush="#2D313A" BorderThickness="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Track 1: Original Vocal Stem Header -->
        <Border Grid.Row="0" Background="#21242C" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="#FF5376"/>
                <TextBlock Text="ORIGINAL VOCAL STEM (REFERENCE)" FontSize="11" FontWeight="SemiBold" Foreground="#F0F2F5"/>
            </StackPanel>
        </Border>

        <!-- Vocal Waveform Canvas -->
        <Canvas x:Name="VocalWaveformCanvas" Grid.Row="1" Background="#0D0E11" MinHeight="70" PointerPressed="OnCanvasPointerPressed"/>

        <!-- Track 2: User Take Header -->
        <Border Grid.Row="2" Background="#21242C" Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Rectangle Width="8" Height="8" RadiusX="4" RadiusY="4" Fill="#00E5A3"/>
                <TextBlock Text="USER RECORDED TAKE (OVERDUB)" FontSize="11" FontWeight="SemiBold" Foreground="#F0F2F5"/>
            </StackPanel>
        </Border>

        <!-- Take Waveform Canvas -->
        <Canvas x:Name="TakeWaveformCanvas" Grid.Row="3" Background="#0D0E11" MinHeight="70" PointerPressed="OnCanvasPointerPressed"/>
    </Grid>
</UserControl>
