<UserControl
    x:Class="DubStage.Views.DubForgeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DubStage.Models">

    <Grid Margin="16" RowSpacing="16" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <!-- Responsive scaling: Column 1 for Video & AI Engine Controls (min 420px), Column 2 for Dialogue Clips (flexible) -->
            <ColumnDefinition Width="7*" MinWidth="420"/>
            <ColumnDefinition Width="5*" MinWidth="340"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT COLUMN: Video Monitor + AI Stem Engine Workbench -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <!-- Video Monitor Section -->
                <Border Background="#16181D" BorderBrush="#2D313A" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="VIDEO MONITOR" FontSize="12" FontWeight="Bold" Foreground="#9AA0A6"/>
                            <TextBlock Text="{x:Bind ViewModel.ProjectTitle, Mode=OneWay}" FontSize="12" Foreground="#4F80FF" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Media Player Element -->
                        <Border Height="280" Background="#0D0E11" CornerRadius="6" BorderBrush="#21242C" BorderThickness="1">
                            <MediaPlayerElement x:Name="PlayerElement" AreTransportControlsEnabled="False" Stretch="Uniform"/>
                        </Border>

                        <!-- Video Scrub Bar & Timecode -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{x:Bind ViewModel.TogglePlayPauseCommand}" Background="#21242C" Padding="12,6" CornerRadius="6">
                                <FontIcon Glyph="{x:Bind ViewModel.IsPlaying, Mode=OneWay, Converter={StaticResource PlayPauseIconConverter}}" FontSize="14" Foreground="#F0F2F5"/>
                            </Button>

                            <Slider Grid.Column="1" Minimum="0" Maximum="{x:Bind ViewModel.VideoDurationMsDouble, Mode=OneWay}" Value="{x:Bind ViewModel.PlayheadMsDouble, Mode=TwoWay}" VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TimecodeDisplay, Mode=OneWay}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="13" Foreground="#00E5A3"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Model Downloader & Sideload Card -->
                <Border Background="#16181D" BorderBrush="#2D313A" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="DEMUCS v4 NEURAL WEIGHTS" FontSize="12" FontWeight="Bold" Foreground="#9AA0A6"/>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0" ItemsSource="{x:Bind AvailablePresets}" SelectedItem="{x:Bind ViewModel.SelectedModelPreset, Mode=TwoWay}" DisplayMemberPath="DisplayName" HorizontalAlignment="Stretch"/>

                            <Button Grid.Column="1" Content="Download Weights" Click="OnDownloadModelClick" Background="#4F80FF" Foreground="White" FontWeight="SemiBold" CornerRadius="6"/>
                            <Button Grid.Column="2" Content="Sideload .onnx" Click="OnSideloadModelClick" Background="#21242C" Foreground="#F0F2F5" CornerRadius="6"/>
                        </Grid>

                        <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsSeparating, Mode=OneWay}" Value="{x:Bind ViewModel.SeparationProgress.PercentDouble, Mode=OneWay, FallbackValue=0}" Foreground="#4F80FF" Background="#21242C" Height="6" CornerRadius="3"/>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="#9AA0A6"/>
                    </StackPanel>
                </Border>

                <!-- DSP & Dialogue Segmentation Workbench -->
                <Border Background="#16181D" BorderBrush="#2D313A" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="STUDIO DSP ACTIONS" FontSize="12" FontWeight="Bold" Foreground="#9AA0A6"/>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="1. Extract Audio" Click="OnExtractAudioClick" Background="#21242C" Foreground="#F0F2F5" CornerRadius="6"/>
                            <Button Content="2. Separate Stems (AI)" Click="OnSeparateStemsClick" Background="#4F80FF" Foreground="White" FontWeight="SemiBold" CornerRadius="6"/>
                            <Button Content="3. Detect Dialogue (VAD)" Click="OnDetectDialogueClick" Background="#9D65FF" Foreground="White" FontWeight="SemiBold" CornerRadius="6"/>
                        </StackPanel>

                        <Grid ColumnSpacing="12" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VAD Sensitivity:" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" Minimum="0.1" Maximum="0.95" StepFrequency="0.05" Value="{x:Bind ViewModel.VadSensitivityDouble, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.VadSensitivity, Mode=OneWay}" FontSize="12" Foreground="#00E5A3" VerticalAlignment="Center" FontFamily="Consolas"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT COLUMN: Dialogue Clips Master List & Script Editor -->
        <Border Grid.Column="1" Background="#16181D" BorderBrush="#2D313A" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="DIALOGUE CLIPS &amp; SCRIPT" FontSize="12" FontWeight="Bold" Foreground="#9AA0A6"/>
                    <TextBlock Text="{x:Bind ViewModel.Clips.Count, Mode=OneWay, Converter={StaticResource ClipCountConverter}}" FontSize="12" Foreground="#00E5A3" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Clips List -->
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Clips, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.ActiveClip, Mode=TwoWay}" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ClipEntity">
                            <Border Background="#21242C" CornerRadius="6" BorderBrush="#2D313A" BorderThickness="1" Margin="0,3" Padding="10">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Index, Speaker, Time range -->
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="#4F80FF" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{x:Bind ClipIndex}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                            <TextBox Text="{x:Bind SpeakerName, Mode=TwoWay}" FontSize="12" FontWeight="SemiBold" Foreground="#00E5A3" Background="Transparent" BorderThickness="0" Padding="0"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind DurationMs, Converter={StaticResource MsToTimecodeConverter}}" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                    </Grid>

                                    <!-- Bottom Row: Script Text -->
                                    <TextBox Grid.Row="1" Text="{x:Bind ScriptText, Mode=TwoWay}" PlaceholderText="Enter dialogue line script..." FontSize="13" Foreground="#F0F2F5" Background="#16181D" BorderBrush="#2D313A" BorderThickness="1" CornerRadius="4"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Quick Action Footer -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Switch to DubStage (2)" Click="OnSwitchToStageClick" Background="#00E5A3" Foreground="Black" FontWeight="Bold" CornerRadius="6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
