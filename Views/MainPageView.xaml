<UserControl
    x:Class="DubStage.Views.MainPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DubStage.Views">

    <Grid Background="#0D0E11">
        <!-- Keyboard Accelerators for Windows DAW Navigation -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Space" Modifiers="None" Invoked="OnSpaceAcceleratorInvoked"/>
            <KeyboardAccelerator Key="R" Modifiers="None" Invoked="OnRecordAcceleratorInvoked"/>
            <KeyboardAccelerator Key="Up" Modifiers="None" Invoked="OnUpAcceleratorInvoked"/>
            <KeyboardAccelerator Key="Down" Modifiers="None" Invoked="OnDownAcceleratorInvoked"/>
            <KeyboardAccelerator Key="Left" Modifiers="None" Invoked="OnLeftAcceleratorInvoked"/>
            <KeyboardAccelerator Key="Right" Modifiers="None" Invoked="OnRightAcceleratorInvoked"/>
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnOpenAcceleratorInvoked"/>
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="OnExportAcceleratorInvoked"/>
            <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnSaveAcceleratorInvoked"/>
            <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="OnMuteAcceleratorInvoked"/>
            <KeyboardAccelerator Key="Delete" Modifiers="None" Invoked="OnDeleteAcceleratorInvoked"/>
            <KeyboardAccelerator Key="Number1" Modifiers="None" Invoked="OnTab1AcceleratorInvoked"/>
            <KeyboardAccelerator Key="Number2" Modifiers="None" Invoked="OnTab2AcceleratorInvoked"/>
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main DAW Workbench Workspace -->
            <RowDefinition Height="*"/>
            <!-- Status & Metadata Footer Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TITLE BAR & WORKBENCH TABS -->
        <Border Grid.Row="0" Background="#16181D" BorderBrush="#2D313A" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <!-- App Branding -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Tab Switcher (Forge vs Stage) -->
                    <ColumnDefinition Width="*"/>
                    <!-- Project Actions (Open, Save, Export) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/StoreLogo.png" Width="26" Height="26"/>
                    <TextBlock Text="DubStage" FontSize="16" FontWeight="Bold" Foreground="#F0F2F5" VerticalAlignment="Center"/>
                    <Border Background="#21242C" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="STUDIO" FontSize="10" FontWeight="Bold" Foreground="#4F80FF"/>
                    </Border>
                </StackPanel>

                <!-- Tab Segmented Navigation Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- DubForge Tab Button -->
                    <Button Click="OnDubForgeTabClick" Background="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource Tab0BrushConverter}}" Padding="16,6" CornerRadius="6" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE714;" FontSize="13" Foreground="#F0F2F5"/>
                            <TextBlock Text="DubForge (1)" FontSize="13" FontWeight="SemiBold" Foreground="#F0F2F5"/>
                        </StackPanel>
                    </Button>

                    <!-- DubStage Tab Button -->
                    <Button Click="OnDubStageTabClick" Background="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource Tab1BrushConverter}}" Padding="16,6" CornerRadius="6" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE720;" FontSize="13" Foreground="#F0F2F5"/>
                            <TextBlock Text="DubStage Booth (2)" FontSize="13" FontWeight="SemiBold" Foreground="#F0F2F5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Project Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Open Video (Ctrl+O)" Click="OnOpenVideoClick" Background="#21242C" Foreground="#F0F2F5" FontSize="12" CornerRadius="6"/>
                    <Button Content="Save (Ctrl+S)" Command="{x:Bind ViewModel.SaveProjectCommand}" Background="#21242C" Foreground="#F0F2F5" FontSize="12" CornerRadius="6"/>
                    <Button Content="Export (Ctrl+E)" Click="OnExportClick" Background="#4F80FF" Foreground="White" FontWeight="Bold" FontSize="12" CornerRadius="6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKBENCH VIEWPORT -->
        <Grid Grid.Row="1">
            <!-- View 0: DubForge -->
            <views:DubForgeView ViewModel="{x:Bind ViewModel, Mode=OneWay}" DataContext="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource Tab0VisibilityConverter}}"/>

            <!-- View 1: DubStage -->
            <views:DubStageView ViewModel="{x:Bind ViewModel, Mode=OneWay}" DataContext="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.SelectedTabIndex, Mode=OneWay, Converter={StaticResource Tab1VisibilityConverter}}"/>
        </Grid>

        <!-- STATUS BAR & AUDIO ENGINE STATS -->
        <Border Grid.Row="2" Background="#16181D" BorderBrush="#2D313A" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Status message -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Rectangle Width="6" Height="6" RadiusX="3" RadiusY="3" Fill="#00E5A3"/>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="#9AA0A6"/>
                </StackPanel>

                <!-- Right: Engine info & shortcuts quick reference -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="44.1 kHz | 16-bit Stereo" FontSize="11" Foreground="#5E636E" FontFamily="Consolas"/>
                    <TextBlock Text="[Space] Play  [R] Rec  [↑/↓] Cue  [Ctrl+O] Open" FontSize="11" Foreground="#5E636E"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
