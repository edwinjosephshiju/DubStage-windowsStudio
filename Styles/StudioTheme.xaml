<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DubStage Dark DAW Palette -->
    <Color x:Key="StudioCanvasColor">#0D0E11</Color>
    <Color x:Key="StudioContainerColor">#16181D</Color>
    <Color x:Key="StudioElevatedColor">#21242C</Color>
    <Color x:Key="StudioBorderColor">#2D313A</Color>
    <Color x:Key="StudioBorderBrightColor">#3F4654</Color>
    <Color x:Key="StudioAccentColor">#4F80FF</Color>
    <Color x:Key="StemVocalColor">#FF5376</Color>
    <Color x:Key="StemUserTakeColor">#00E5A3</Color>
    <Color x:Key="StemBackingColor">#9D65FF</Color>
    <Color x:Key="StatusRecordingColor">#FF334B</Color>
    <Color x:Key="WarningAmberColor">#FFB020</Color>

    <Color x:Key="TextHighEmphasisColor">#F0F2F5</Color>
    <Color x:Key="TextMediumEmphasisColor">#9AA0A6</Color>
    <Color x:Key="TextDisabledColor">#5E636E</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="StudioCanvasBrush" Color="{StaticResource StudioCanvasColor}" />
    <SolidColorBrush x:Key="StudioContainerBrush" Color="{StaticResource StudioContainerColor}" />
    <SolidColorBrush x:Key="StudioElevatedBrush" Color="{StaticResource StudioElevatedColor}" />
    <SolidColorBrush x:Key="StudioBorderBrush" Color="{StaticResource StudioBorderColor}" />
    <SolidColorBrush x:Key="StudioBorderBrightBrush" Color="{StaticResource StudioBorderBrightColor}" />
    <SolidColorBrush x:Key="StudioAccentBrush" Color="{StaticResource StudioAccentColor}" />
    <SolidColorBrush x:Key="StemVocalBrush" Color="{StaticResource StemVocalColor}" />
    <SolidColorBrush x:Key="StemUserTakeBrush" Color="{StaticResource StemUserTakeColor}" />
    <SolidColorBrush x:Key="StemBackingBrush" Color="{StaticResource StemBackingColor}" />
    <SolidColorBrush x:Key="StatusRecordingBrush" Color="{StaticResource StatusRecordingColor}" />
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmberColor}" />

    <SolidColorBrush x:Key="TextHighEmphasisBrush" Color="{StaticResource TextHighEmphasisColor}" />
    <SolidColorBrush x:Key="TextMediumEmphasisBrush" Color="{StaticResource TextMediumEmphasisColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <!-- Studio DAW Card Style -->
    <Style x:Key="StudioCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StudioContainerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- Studio DAW Button Style -->
    <Style x:Key="StudioAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource StudioAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Studio DAW Secondary Button Style -->
    <Style x:Key="StudioSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource StudioElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextHighEmphasisBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StudioBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <!-- Recording Tally Button Style -->
    <Style x:Key="StudioRecordButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource StatusRecordingBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>
